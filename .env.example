BOT_TOKEN=
BOT_ENABLED=true
HOST=127.0.0.1
PORT=8000
GROUP_DELAY_SECONDS=1
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=30
CLASSIFICATION_TIMEOUT_SECONDS=2
OLLAMA_MAX_CONCURRENCY=4
HISTORY_PATH=.run/conversations.sqlite3
REMINDERS_PATH=.run/reminders.sqlite3
ANALYTICS_PATH=.run/events.sqlite3
# Event rows contain only opaque operation IDs and type, never question text or Telegram IDs.
ANALYTICS_RETENTION_DAYS=90
HISTORY_CONTEXT_CHARS=12000
DEMO_USERS_ENABLED=true
ACCOUNTS_PATH=.run/accounts.sqlite3

# Local AI/ML
AI_ENABLED=true
# alfa-ai CLI also accepts these variables with uv run --env-file .env.
AI_CORPUS_PATH=assets/reviewed_articles.jsonl
AI_OLLAMA_URL=http://127.0.0.1:11434
# Explicit Docker-internal service or Docker Desktop host gateway only.
# AI_OLLAMA_INTERNAL_HOST=host.docker.internal
AI_MODEL=qwen35-unc-local:latest
AI_MODEL_DIGEST=4cde2d71a709d75cf51d3d0e45432995ac55457175f73e96ca5d47376c721173
AI_REQUEST_TIMEOUT=60
AI_HTTP_TIMEOUT=45
AI_MAX_WORKERS=1
# Includes running and queued requests.
AI_MAX_PENDING=4
# Manually reviewed public podcast excerpts with pinned timestamps.
AI_PODCAST_CORPUS_PATH=assets/reviewed_podcasts.json
AI_PODCAST_CORPUS_SHA256=3df378f54466076cb9a317b62e7385074161046e9a04e50271d32c9ec7ad106c
# Optional local multilingual E5 snapshot for semantic retrieval within named episodes.
# AI_E5_MODEL_DIR=<directory with tokenizer.json and onnx/model.onnx>
